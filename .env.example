# ───────────────────────────────────────────────────────────────
# AARABHYATE RESEARCH GROUP — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ───────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────
PORT=8080
APP_ENV=development   # development | staging | production

# ── PostgreSQL ──────────────────────────────────────────────────
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
DATABASE_URL=postgres://aarabhyate_user:strongpassword@localhost:5432/aarabhyate_db?sslmode=disable

# ── Connection Pool ─────────────────────────────────────────────
DB_MAX_OPEN=25        # max open connections
DB_MAX_IDLE=5         # max idle connections
DB_CONN_TTL=5m        # connection max lifetime

# ── JWT ─────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=REPLACE_ME_WITH_A_STRONG_SECRET_KEY
JWT_EXPIRATION=24h

# ── SMTP (OTP email dispatch) ────────────────────────────────────
# Gmail example — create an App Password at myaccount.google.com/apppasswords
# Other providers: Mailgun (smtp.mailgun.org:587), SendGrid (smtp.sendgrid.net:587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=noreply@aarabhyate.com
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
